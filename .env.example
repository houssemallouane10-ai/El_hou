# Copy the values you need into your hosting provider's environment settings.

# Port the server listens on.
PORT=3000

# Use "production" when deployed.
NODE_ENV=production

# Folder for the SQLite database. Must be on a persistent disk/volume.
DATA_DIR=/data

# Public address of the site (link previews, sitemap, canonical URLs).
PUBLIC_URL=https://khedmati.example

# Set to 1 behind an HTTPS proxy (Render, Railway, Fly.io, Nginx, Caddy) so secure cookies and client IPs work.
TRUST_PROXY=1

# Owner code: whoever enters it at sign-up (or in Settings) becomes an owner, with every admin right
# and the power to appoint moderators. At least 8 characters; keep it secret.
OWNER_CODE=

# Optional support contacts, shown on "forgot password", privacy and account deletion pages.
SUPPORT_WHATSAPP=0661234567
SUPPORT_EMAIL=contact@khedmati.example

# Android app on Google Play (Trusted Web Activity), served as /.well-known/assetlinks.json.
# Fingerprints: the "App signing key certificate" SHA-256 from Play Console, and your upload key's.
ANDROID_PACKAGE_NAME=dz.khedmati.app
ANDROID_SHA256_FINGERPRINTS=

# Session lifetime in days.
SESSION_DAYS=60

# Daily database copies kept in DATA_DIR/backups (0 turns backups off).
BACKUP_DAYS=7
